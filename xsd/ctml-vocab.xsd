<?xml version="1.0" encoding="UTF-8"?>
<!-- ctml-vocab.xsd -->
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:ctml="urn:ctml:2.0"
  targetNamespace="urn:ctml:2.0"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation>
      CTML 2.0 - Controlled vocabularies and small constrained simple types.
      Intended to be xs:include'd into a single driver schema (ctml-core.xsd).
      Carried over from the v1 module (reference/v1-xsd/ctml-vocab.xsd) with no
      structural changes: this module was already assertion-free, so the XSD
      1.0 rewrite required nothing here beyond dropping vc:minVersion.
    </xs:documentation>
  </xs:annotation>

  <!-- Basic code patterns -->

  <xs:simpleType name="EcoCodeType">
    <xs:restriction base="xs:token">
      <xs:pattern value="[A-E][0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FederationCodeType">
    <!-- FIDE-style 3-letter federation code (e.g., USA, IND, RUS) -->
    <xs:restriction base="xs:token">
      <xs:pattern value="[A-Z]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Iso2CountryCodeType">
    <xs:restriction base="xs:token">
      <xs:pattern value="[A-Z]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Iso3CountryCodeType">
    <xs:restriction base="xs:token">
      <xs:pattern value="[A-Z]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LanguageTagType">
    <!-- BCP-47-ish (kept permissive) -->
    <xs:restriction base="xs:token">
      <xs:pattern value="[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Chess / tournament enums -->

  <xs:simpleType name="GameResultType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="1-0"/>
      <xs:enumeration value="0-1"/>
      <xs:enumeration value="1/2-1/2"/>
      <!-- Double loss / annulled: occurs in online events (e.g. chess.com
           speed championships, both players lose on forfeit/abort). Not part
           of the PGN standard but present in real curated data. -->
      <xs:enumeration value="0-0"/>
      <xs:enumeration value="*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TerminationType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="normal"/>
      <xs:enumeration value="resignation"/>
      <xs:enumeration value="checkmate"/>
      <xs:enumeration value="timeout"/>
      <xs:enumeration value="stalemate"/>
      <xs:enumeration value="agreement"/>
      <xs:enumeration value="adjudication"/>
      <xs:enumeration value="forfeit"/>
      <xs:enumeration value="abandoned"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EventCadenceType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="classical"/>
      <xs:enumeration value="rapid"/>
      <xs:enumeration value="blitz"/>
      <xs:enumeration value="bullet"/>
      <xs:enumeration value="correspondence"/>
      <xs:enumeration value="mixed"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EventFormatType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="round-robin"/>
      <xs:enumeration value="swiss"/>
      <xs:enumeration value="match"/>
      <xs:enumeration value="team"/>
      <xs:enumeration value="knockout"/>
      <xs:enumeration value="scheveningen"/>
      <xs:enumeration value="other"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MoveNotationType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="uci"/>
      <xs:enumeration value="san"/>
      <xs:enumeration value="lan"/>
      <xs:enumeration value="pgn"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PlaceKindType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="country"/>
      <xs:enumeration value="admin1"/>
      <xs:enumeration value="admin2"/>
      <xs:enumeration value="city"/>
      <xs:enumeration value="venue"/>
      <xs:enumeration value="other"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RatingSystemType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="fide"/>
      <xs:enumeration value="uscf"/>
      <xs:enumeration value="ecf"/>
      <xs:enumeration value="national"/>
      <xs:enumeration value="online"/>
      <xs:enumeration value="edo"/>
      <xs:enumeration value="chessmetrics"/>
      <xs:enumeration value="combined"/>
      <xs:enumeration value="none"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RatingScopeType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="standard"/>
      <xs:enumeration value="rapid"/>
      <xs:enumeration value="blitz"/>
      <xs:enumeration value="bullet"/>
      <xs:enumeration value="mixed"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RoundType">
    <!-- PGN round labels are not always integers: "4.1", "-", "?" all occur
         in real data. Kept permissive; exporters may normalize. -->
    <xs:restriction base="xs:token">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ResolutionMethodType">
    <!-- How a playerRef's @ref was determined from the source data. -->
    <xs:restriction base="xs:token">
      <xs:enumeration value="fide-id"/>         <!-- matched by FIDE ID present in source -->
      <xs:enumeration value="name-exact"/>      <!-- registry display/sort name key match -->
      <xs:enumeration value="name-alias"/>      <!-- registry alias key match -->
      <xs:enumeration value="surname-unique"/>  <!-- single-token surname, unique candidate -->
      <xs:enumeration value="manual"/>          <!-- resolved by human curation -->
      <xs:enumeration value="unresolved"/>      <!-- synthetic ref; no registry identity -->
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PlayerTitleType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="GM"/>
      <xs:enumeration value="IM"/>
      <xs:enumeration value="FM"/>
      <xs:enumeration value="CM"/>
      <xs:enumeration value="WGM"/>
      <xs:enumeration value="WIM"/>
      <xs:enumeration value="WFM"/>
      <xs:enumeration value="WCM"/>
      <xs:enumeration value="NM"/>
      <xs:enumeration value="none"/>
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonGameKindType">
    <!-- What happened in a round-participant slot that is NOT a played game
         between two known opponents. Added 2026-08-05 to close a real
         representational gap: crosstables (round-robin and, especially,
         Swiss) routinely have cells that are not games at all, and a
         ctml:game element cannot express them since @white/@black are both
         required IDREFs. Covers the single-sided cases; a scheduled pairing
         where neither side played (a "double forfeit") already has a home
         as an ordinary ctml:game with result="0-0" termination="forfeit",
         both of which already existed before this addition, so that case
         needed no new vocabulary. -->
    <xs:restriction base="xs:token">
      <xs:enumeration value="bye-full"/>      <!-- full-point bye: odd player count, no opponent existed -->
      <xs:enumeration value="bye-half"/>      <!-- half-point bye -->
      <xs:enumeration value="bye-zero"/>      <!-- zero-point / unrequested bye -->
      <xs:enumeration value="forfeit-win"/>   <!-- awarded a win with no game played; opponent may or may not be known -->
      <xs:enumeration value="forfeit-loss"/>  <!-- charged a loss with no game played -->
      <xs:enumeration value="withdrawn"/>     <!-- participant had left the event by this round -->
      <xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
